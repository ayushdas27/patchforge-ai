# Environment variables for PATCHFORGE AI
# Copy this file to .env and configure your local values.
# NEVER commit .env to Git or share your secret API key.

# Nebius Token Factory API Configuration
# Base URL for OpenAI-compatible Nebius Token Factory inference
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1/

# API Key obtained from Nebius Token Factory console
# Place your real key in .env (never share or commit)
NEBIUS_API_KEY=your_nebius_api_key_here

# Candidate model ID (e.g., nvidia/Nemotron-3-Ultra-550b-a55b or eligible Nemotron model)
NEBIUS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Application Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Execution limits
MAX_REPAIR_ATTEMPTS=2
TEST_TIMEOUT_SECONDS=60
MAX_MODEL_CALLS_PER_TASK=8
